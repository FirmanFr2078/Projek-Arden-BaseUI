# ============================================================
# SUPABASE
# ============================================================

# URL utama project Supabase.
# Diambil dari Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=

# Publishable Key — aman digunakan di client/browser/mobile.
# Pengganti modern untuk legacy "anon" key.
# Diambil dari Supabase Dashboard > Settings > API Keys
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy anon key — sementara dipertahankan untuk kompatibilitas
# dengan kode lama yang masih menggunakannya.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret Key — KHUSUS server/backend.
# Memiliki akses tinggi dan melewati Row Level Security (RLS).
# JANGAN pernah expose ke browser/client.
# Diambil dari Supabase Dashboard > Settings > API Keys
SUPABASE_SECRET_KEY=

# Legacy service_role key — sementara dipertahankan untuk kompatibilitas
# dengan kode lama. Jangan expose ke client.
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# AUTH / JWT
# ============================================================

# JWT Secret dari konfigurasi JWT Supabase.
# Saat ini masih diperlukan oleh sistem autentikasi ARDEN
# yang melakukan verifikasi JWT secara manual.
JWT_SECRET=

# ============================================================
# DATABASE
# ============================================================

# Connection Pooling — digunakan aplikasi/runtime untuk koneksi
# database melalui Prisma.
DATABASE_URL="postgresql://postgres...."

# Direct PostgreSQL Connection — digunakan Prisma untuk migration
# dan operasi yang membutuhkan direct connection.
DIRECT_URL="postgresql://postgres....."


# Secret khusus untuk JWT cookie internal ARDEN.
# Buat nilai acak minimal 32 karakter.
ARDEN_SESSION_SECRET=

# ============================================================
# ARDEN BOOTSTRAP ADMIN
# ============================================================

# Identitas akun internal pertama.
SEED_ADMIN_USERNAME=antrana
SEED_ADMIN_NAME=Ananda

# Hanya dibaca oleh Prisma seed pertama kali.
# Gunakan password kuat minimal 8 karakter.
# Setelah seed berhasil, nilai ini boleh dihapus dari .env.local
# jika sudah disimpan aman di password manager.
SEED_ADMIN_PASSWORD=Ad-Firman09


# URL API Waktu Sholat
NEXT_PUBLIC_API_TIME_SHOLAT=https://api.aladhan.com

# URL Base aplikasi kita
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Bila kelak backend dipisah:
#NEXT_PUBLIC_API_BASE_URL=https://api.arden.example

# Image Supabase
SUPABASE_IMAGE_HOSTNAME=

# Menyembunyikan peringatan Turbopack dari Serwist (PWA) di terminal saat mode development
SERWIST_SUPPRESS_TURBOPACK_WARNING=1

# ============================================================
# DEVELOPMENT ACCESS
# ============================================================

# Hanya melonggarkan capability route desktop di local development.
# Login, JWT, user aktif, dan pemisahan Pelaksana/mobile tetap berlaku.
#
# Jangan pernah isi true pada environment production/Vercel.
ARDEN_DEV_RELAXED_DESKTOP_ACCESS=true

